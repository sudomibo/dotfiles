defaults
auth on
tls on
tls_trust_file ~/imap.suse.de
logfile /tmp/msmtp.log

account suse.de
host imap.suse.de
port 587
protocol smtp
tls_starttls on
from mbozicevic@suse.de
user username
# gpg -e -r 1BA5FA970BF2B0DC80686F54D5FE67058C77798E imap.suse.de
passwordeval "/usr/bin/gpg --no-tty -q -d ~/keys/imap.suse.de.gpg"
 
